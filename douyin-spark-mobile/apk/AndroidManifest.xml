<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.spark.keeper"
    android:versionCode="21"
    android:versionName="0.5.1">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="30"/>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- 静默亮度必需:缺少该声明时 Settings.System.canWrite() 恒为 false,
         且应用不会出现在系统「修改系统设置」授权页里,导致该功能完全不可用 -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"/>
    <!-- Android 12+ 精确闹钟:部分 ROM 未声明时会把精确闹钟降级 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- WebView(网页登录/协议模式)必需:此前遗漏导致所有网页报 ERR_CACHE_MISS -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 悬浮窗权限:targetSdk 30+ 后台启动 Activity 的官方豁免通道,
         同时也是小米等系统绕过「后台弹出界面」拦截的实用手段 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- 首次引导里"关闭电池优化"直接弹系统授权框需要它;不申请的话只能跳设置页让用户自己找 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Android 13+ 运行结果通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Shizuku:以 shell 身份执行命令所需的权限(装并授权 Shizuku 后才生效) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23"/>

    <!-- Android 11+ 包可见性:不声明就既查不到抖音的启动 Intent,
         也无法跳转到各厂商"安全中心/自启动管理"页面 -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme"/>
        <!-- 厂商自启动/电池/权限管理页(与 PermissionGuide 的候选链对应) -->
        <package android:name="com.miui.securitycenter"/>
        <package android:name="com.miui.powerkeeper"/>
        <package android:name="com.huawei.systemmanager"/>
        <package android:name="com.coloros.safecenter"/>
        <package android:name="com.coloros.oppoguardelf"/>
        <package android:name="com.oppo.safe"/>
        <package android:name="com.vivo.permissionmanager"/>
        <package android:name="com.iqoo.secure"/>
        <package android:name="com.samsung.android.lool"/>
        <package android:name="com.meizu.safe"/>
        <package android:name="com.oneplus.security"/>
        <package android:name="com.asus.mobilemanager"/>
        <package android:name="com.letv.android.letvsafe"/>
        <package android:name="com.hihonor.systemmanager"/>
        <package android:name="com.lenovo.security"/>
        <package android:name="com.lenovo.safecenter"/>
        <package android:name="com.zui.safecenter"/>
        <package android:name="com.zte.heartyservice"/>
        <package android:name="com.tcl.security"/>
        <package android:name="com.oplus.battery"/>
        <package android:name="com.samsung.android.sm"/>
        <package android:name="com.smartisanos.security"/>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 无障碍服务:执行抖音界面自动化 -->
        <service
            android:name=".SparkService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config"/>
        </service>

        <!-- 前台运行载体:定时触发后真正干活的服务 -->
        <service
            android:name=".RunnerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"/>

        <!-- 常驻保活:提升进程优先级,避免被清理导致无障碍失效 -->
        <service android:name=".KeepAliveService" android:exported="false"/>

        <!-- 实验性协议模式:网页登录页 -->
        <activity
            android:name=".ProtocolLoginActivity"
            android:exported="false"
            android:label="网页登录(协议模式)"/>

        <!-- 首次使用引导:模式选择 + 权限清单(按厂商跳转)-->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:label="首次使用引导"/>

        <!-- Shizuku API 要求声明的 Provider:它负责把 Shizuku 服务的 binder 传进来 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.spark.keeper.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"/>

        <activity android:name=".AccessibilityConfigActivity" android:exported="false"/>
        <activity android:name=".ProtocolConfigActivity" android:exported="false"/>

        <receiver android:name=".AlarmReceiver" android:exported="false"/>

        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <!-- 覆盖安装后系统会丢弃已注册的闹钟,必须靠这个广播重建 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
